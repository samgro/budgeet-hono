meta {
  name: Transactions (search)
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/transactions?q=coffee
  body: none
  auth: inherit
}

docs {
  Searches resolved description, raw_description, raw_merchant_name, and
  ugc_note, case-insensitively. % and _ in q are escaped before reaching
  ilike, so a literal "%" or "_" in a merchant name can't be used to widen
  the match.
}
