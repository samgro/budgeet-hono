# GCP service account for read-only (Viewer) access to the Tiller sheet.
# Base64-encoded — same format used in Railway (see SDG-179 for local setup,
# SDG-208 for Railway). Decode logic lives in lib/sheets.ts (SDG-189).
GOOGLE_SERVICE_ACCOUNT_JSON=

# Tiller Google Sheet ID (SDG-179)
TILLER_SHEET_ID=

# Bearer token — shared secret for all API auth. Generate with:
#   openssl rand -hex 32
API_TOKEN=

# Neon Postgres connection string (pooled)
DATABASE_URL=

# Claude API key
ANTHROPIC_API_KEY=